{
  "name": "getlaraplate/larasao",
  "vendor": "getlaraplate",
  "description": "SAO (Simply Another Orchestrator): ticketing that correlates code, errors and work, with issue tracker, VCS and log integrations.",
  "version": "v1.5.1",
  "keywords": [
    "laravel",
    "laraplate",
    "sao",
    "orchestrator",
    "issue-tracking"
  ],
  "authors": [
    {
      "name": "Swolley",
      "email": "myentity@inwind.it"
    }
  ],
  "license": "AGPL-3.0-or-later",
  "type": "laravel-module",
  "require": {
    "php": ">=8.5",
    "laravel/framework": "^12.0"
  },
  "scripts": {
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [],
      "aliases": {}
    }
  },
  "autoload": {
    "psr-4": {
      "Modules\\SAO\\": "app/",
      "Modules\\SAO\\Database\\Factories\\": "database/factories/",
      "Modules\\SAO\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\SAO\\Tests\\Unit\\": "tests/Unit",
      "Modules\\SAO\\Tests\\Feature\\": "tests/Feature",
      "Modules\\SAO\\Tests\\Integration\\": "tests/Integration",
      "Modules\\SAO\\Tests\\Support\\": "tests/Support/"
    },
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
